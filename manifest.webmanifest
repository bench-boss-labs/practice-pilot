{
  "name": "Practice Pilot \u00b7 Bench Boss Labs",
  "short_name": "Practice Pilot",
  "description": "Practice plans and animated drills for youth hockey coaches.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0B1B31",
  "theme_color": "#0B1B31",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://bench-boss-labs.github.io/practice-pilot/manifest.webmanifest"
    }
  ],
  "prefer_related_applications": false
}
